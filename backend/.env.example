# OpenRouter API Key for AI Demand Forecasting and Natural Language Q&A
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BACKUP_API_KEY=sk-or-v1-your-backup-openrouter-key-here

# Valid OpenRouter Model (e.g. google/gemini-2.0-flash-01 or openai/gpt-4o-mini)
OPENROUTER_MODEL=google/gemini-2.0-flash-01

# Flask Port (Default: 5001)
PORT=5001
